{
  "openapi": "3.1.0",
  "info": {
    "title": "spike",
    "version": "0"
  },
  "paths": {
    "/trips/{tripId}/plan": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "tripId",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripPlan"
                }
              }
            }
          },
          "404": {
            "description": "nf",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/trips/{tripId}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "tripId",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trip"
                }
              }
            }
          }
        }
      }
    },
    "/trips/{tripId}/places": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "tripId",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "required": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddTripPlaceBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripPlanOwner"
                }
              }
            }
          },
          "422": {
            "description": "invalid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/places/search": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "default": "",
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "in": "query",
            "name": "locale",
            "schema": {
              "type": "string",
              "enum": [
                "pt-BR",
                "en"
              ]
            },
            "required": true
          },
          {
            "in": "query",
            "name": "intent",
            "schema": {
              "default": "autocomplete",
              "type": "string",
              "enum": [
                "autocomplete",
                "submit"
              ]
            }
          },
          {
            "in": "query",
            "name": "near",
            "schema": {
              "description": "Bias point \"lng,lat\"",
              "example": "-9.1393,38.7223",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "zoom",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 22
            }
          },
          {
            "in": "query",
            "name": "within",
            "schema": {
              "description": "Bounding box \"west,south,east,north\"",
              "example": "-9.23,38.69,-9.09,38.80",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "categories",
            "schema": {
              "description": "Comma-separated place categories",
              "example": "sight,food",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 6,
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  },
