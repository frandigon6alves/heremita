{
  "name": "@heremita/web",
  "version": "0.0.0",
  "private": true,
  "description": "Heremita web app (Next.js App Router, mobile first).",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=mobile-chromium --project=desktop-chromium",
    "e2e:webkit": "playwright test --project=mobile-webkit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heremita/shared": "workspace:*",
    "@hookform/resolvers": "^7.0.7",
    "@tanstack/react-query": "^5.108.0",
    "downshift": "^9.5.0",
    "maplibre-gl": "^6.19.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "nuqs": "^2.10.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/geojson": "^7946.0.16",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "msw": "3.0.6",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.8",
    "vitest": "catalog:"
  }
}
