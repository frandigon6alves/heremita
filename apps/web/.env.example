# Where the Next.js server forwards /api/* requests. The browser only ever talks
# to the web origin. This value is read when the server starts (dev) or when the
# app is built (production): change it and restart / rebuild.
API_URL=http://localhost:3101

# Name of the API's session cookie: hm_session when the API runs with
# COOKIE_SECURE=false (local http), __Host-hm_session when it is true (https).
SESSION_COOKIE_NAME=hm_session

# Operator contact shown on /about (the routing provider asks for one). Required
# in production; leave empty locally and the page says it is not configured.
CONTACT_EMAIL=

# Basemap styles. Defaults (when unset): OpenFreeMap positron / dark, with the
# VersaTiles colorful / eclipse styles as fallback when OpenFreeMap fails.
# NEXT_PUBLIC_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
# NEXT_PUBLIC_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
# NEXT_PUBLIC_MAP_STYLE_FALLBACK_LIGHT=https://tiles.versatiles.org/assets/styles/colorful/style.json
# NEXT_PUBLIC_MAP_STYLE_FALLBACK_DARK=https://tiles.versatiles.org/assets/styles/eclipse/style.json

# Only e2e builds set this to 1 (exposes a map test hook).
# NEXT_PUBLIC_E2E=1
