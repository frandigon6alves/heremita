# Copied to .env by `pnpm env:init`. Development values only: no real secrets.

# Port the API listens on.
PORT=3101

# Development database: the "postgres" service of docker-compose.yml (host port 5434).
DATABASE_URL=postgresql://heremita:heremita@localhost:5434/heremita

# Template database of the tests. The test runner drops, recreates and migrates
# it on every run, and each test file works on its own copy of it. The database
# name must end in "_test".
TEST_DATABASE_URL=postgresql://heremita:heremita@localhost:5434/heremita_test

# Exact origin of the web app. Unsafe requests without Sec-Fetch-Site must send it as Origin.
WEB_ORIGIN=http://localhost:3100

# Public address of the site, sent to the map providers (User-Agent, Referer). Required in production.
PUBLIC_SITE_URL=http://localhost:3100

# Session cookie: true -> "__Host-hm_session" + Secure; false -> "hm_session".
# Unset: true only when NODE_ENV=production. The web app's SESSION_COOKIE_NAME must match.
COOKIE_SECURE=false

# Express "trust proxy": hops allowed to set X-Forwarded-For. A production proxy must overwrite that header.
TRUST_PROXY=loopback, uniquelocal

# fatal | error | warn | info | debug
LOG_LEVEL=info

# Geocoding: photon | fake. Routing: osrm | fake. Fake providers answer from a fixed gazetteer.
GEOCODING_PROVIDER=photon
ROUTING_PROVIDER=osrm
# Fake providers in a production build are refused unless this is true (end-to-end tests only).
ALLOW_FAKE_PROVIDERS=false

# Public instances; read their usage policies before changing them (see README).
PHOTON_URL=https://photon.komoot.io
OSRM_URL=https://routing.openstreetmap.de

# Nominatim fallback, off by default. Read https://operations.osmfoundation.org/policies/nominatim/ first.
NOMINATIM_ENABLED=false
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Place suggestions with AI (POST /trips/{tripId}/suggestions): claude | fake | off.
# "fake" suggests gazetteer places near the trip, with no network and no key.
AI_PROVIDER=fake
# Required when AI_PROVIDER=claude. Never commit a real key.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Calls per UTC day for the whole API (a cost cap).
AI_DAILY_LIMIT=200

# Password of every demo account the seed writes (`pnpm db:seed`; at least 12 characters).
DEMO_PASSWORD=heremita-demo-2026

# Shared with the web app (same value in both): the web server signs the browser's
# address with it (HMAC-SHA256) so anonymous rate limits key on the visitor, not on
# the web server's address. Optional in development and test, required in
# production (at least 32 characters). Generate a production value with:
#   openssl rand -base64 32
# This development value is public: never use it in production.
SERVER_FETCH_SECRET=dev-only-server-fetch-secret-never-in-production
