{
  "name": "@heremita/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Heremita: explore public trips, and plan your own with an AI assistant.",
  "type": "module",
  "bin": {
    "heremita-mcp": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "inspect": "pnpm build && npx @modelcontextprotocol/inspector node dist/main.js"
  },
  "dependencies": {
    "@heremita/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
